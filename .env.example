# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/prerna_store?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your-256-bit-access-token-secret-here"
JWT_REFRESH_SECRET="your-256-bit-refresh-token-secret-here"

# Application Endpoints
API_URL="http://localhost:4001"
NEXT_PUBLIC_API_URL="http://localhost:4001/api/v1"
# Set this in apps/web/.env.local after enabling Maps JavaScript API and Places API.
# Restrict the browser key to your development/production referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
PORT=4001
